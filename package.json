{
  "name": "weatherbot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that tells you what your day looks like, starting with rain.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "feedback": "wrangler d1 execute weatherbot --remote --file scripts/feedback.sql",
    "set-webhook": "node --env-file-if-exists=.env scripts/set-webhook.js",
    "simulate": "node scripts/simulate.js",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
